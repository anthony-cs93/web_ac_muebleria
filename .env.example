# AC Mueblería Environment Variables
# Port is managed by the AI Studio environment (default 3000)

# Panel /admin: clave de acceso (obligatoria)
ADMIN_PASSWORD=cambia-esta-clave
# Opcional: secreto para firmar la sesión (si falta se deriva de ADMIN_PASSWORD)
# ADMIN_SECRET=

# Vercel Blob (lo crea Vercel al conectar un Blob store PÚBLICO al proyecto).
# En local, sin este token, el admin guarda en la carpeta .data/
# BLOB_READ_WRITE_TOKEN=

# --- Pedidos y pagos ---
# Mercado Pago (pago con tarjeta): token de acceso de PRODUCCIÓN de tu cuenta (Tus integraciones > Credenciales).
# Para probar usa el token de prueba (empieza con TEST-). Nunca lo subas al repositorio: va en Vercel y en .env.local.
# MP_ACCESS_TOKEN=
# Avisos por email de nuevos pedidos (Resend, resend.com). Con el remitente de prueba solo llega al email de tu cuenta Resend.
# RESEND_API_KEY=
# ORDERS_NOTIFY_EMAIL=ac.muebles.21@gmail.com
# ORDERS_FROM_EMAIL=AC Mueblería <onboarding@resend.dev>
# Dirección pública de la web (para el link de pago y el aviso de Mercado Pago). Si falta, se deduce de la petición.
# SITE_URL=https://ac-muebleria.vercel.app
