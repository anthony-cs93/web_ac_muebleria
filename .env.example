# AC Mueblería Environment Variables
# Port is managed by the AI Studio environment (default 3000)

# Panel /admin: clave de acceso (obligatoria)
ADMIN_PASSWORD=cambia-esta-clave
# Opcional: secreto para firmar la sesión (si falta se deriva de ADMIN_PASSWORD)
# ADMIN_SECRET=

# Vercel Blob (lo crea Vercel al conectar un Blob store PÚBLICO al proyecto).
# En local, sin este token, el admin guarda en la carpeta .data/
# BLOB_READ_WRITE_TOKEN=
